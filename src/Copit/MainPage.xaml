<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Copit.Controls"
             x:Class="Copit.MainPage"
             x:Name="Root"
             BackgroundColor="{StaticResource Bg}">
    <Grid ColumnDefinitions="236,1,*" RowDefinitions="*,1,26">

        <!-- ========== Sidebar ========== -->
        <Grid BackgroundColor="{StaticResource Bg2}" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Padding="10,12,10,8">
            <!-- Marke -->
            <HorizontalStackLayout Spacing="9" Padding="4,0,0,12">
                <c:LogoView WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                <Label Text="Copit" FontAttributes="Bold" FontSize="13.5" VerticalOptions="Center" />
                <Label Text="VIBECODE IDE" Style="{StaticResource Caption}" FontSize="9.5" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Neue Session -->
            <Border Grid.Row="1" BackgroundColor="{StaticResource Text}" Padding="10,7" Margin="0,0,0,10">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NewSessionCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8">
                    <c:Icon Name="plus" Size="14" Color="{StaticResource Bg}" Stroke="1.8" />
                    <Label Text="Neue Session" TextColor="{StaticResource Bg}" FontSize="12.5" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Navigation -->
            <VerticalStackLayout x:Name="NavStack" Grid.Row="2" Spacing="1" />

            <!-- Projekte -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="4,18,0,4">
                <HorizontalStackLayout Spacing="6">
                    <BoxView WidthRequest="6" HeightRequest="6" Color="{StaticResource Muted}" VerticalOptions="Center" />
                    <Label Text="PROJEKTE" Style="{StaticResource Caption}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <c:IconButton Grid.Column="1" Icon="plus" IconSize="13" WidthRequest="24" HeightRequest="24" Command="{Binding NewProjectCommand}" ToolTipProperties.Text="Neues Projekt" />
            </Grid>
            <ScrollView Grid.Row="4">
                <VerticalStackLayout Spacing="1">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Projects}" Spacing="1">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="6,5" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenProjectCommand}" CommandParameter="{Binding Project}" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding Project.EpicKey}" Style="{StaticResource Key}" FontSize="10.5" VerticalOptions="Center" MinimumWidthRequest="62" />
                                    <Label Grid.Column="1" Text="{Binding Project.Name}" FontSize="12.5" TextColor="{StaticResource Text2}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Grid Grid.Column="2">
                                        <c:PulseDot Color="{StaticResource Accent}" Pulsing="{Binding IsRunning}" IsVisible="{Binding IsRunning}" WidthRequest="6" HeightRequest="6" />
                                        <Label Text="{Binding Ago}" Style="{StaticResource Caption}" FontSize="9.5" IsVisible="{Binding IsRunning, Converter={StaticResource Not}}" VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Noch keine Projekte" Style="{StaticResource Caption}" Margin="6,6" IsVisible="{Binding Projects.Count, Converter={StaticResource None}}" />
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout x:Name="NavBottom" Grid.Row="5" Spacing="1" Margin="0,8,0,0" />
        </Grid>

        <BoxView Grid.Column="1" Grid.RowSpan="3" Color="{StaticResource LineSoft}" />

        <!-- ========== Content ========== -->
        <Grid x:Name="ContentHost" Grid.Column="2" />

        <!-- ========== Statusleiste ========== -->
        <BoxView Grid.Row="1" Grid.ColumnSpan="3" Color="{StaticResource LineSoft}" />
        <Grid Grid.Row="2" Grid.ColumnSpan="3" BackgroundColor="{StaticResource Bg2}" Padding="14,0" ColumnSpacing="18"
              ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
            <HorizontalStackLayout Spacing="6" ToolTipProperties.Text="{Binding JiraInfo}">
                <c:PulseDot Color="{Binding JiraColor}" WidthRequest="6" HeightRequest="6" />
                <Label Text="JIRA" Style="{StaticResource Caption}" FontSize="10" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="6" ToolTipProperties.Text="{Binding GitLabInfo}">
                <c:PulseDot Color="{Binding GitLabColor}" WidthRequest="6" HeightRequest="6" />
                <Label Text="GITLAB" Style="{StaticResource Caption}" FontSize="10" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="2" Spacing="6" ToolTipProperties.Text="{Binding ClaudeInfo}">
                <c:PulseDot Color="{Binding ClaudeColor}" WidthRequest="6" HeightRequest="6" />
                <Label Text="CLAUDE" Style="{StaticResource Caption}" FontSize="10" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="3" Spacing="6" ToolTipProperties.Text="{Binding CopilotInfo}">
                <c:PulseDot Color="{Binding CopilotColor}" WidthRequest="6" HeightRequest="6" />
                <Label Text="COPILOT" Style="{StaticResource Caption}" FontSize="10" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="5" Spacing="6" IsVisible="{Binding AnyRunning}">
                <c:PulseDot Color="{StaticResource Accent}" Pulsing="{Binding AnyRunning}" WidthRequest="6" HeightRequest="6" />
                <Label Text="{Binding RunningInfo}" Style="{StaticResource Caption}" FontSize="10" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Grid.Column="6" Text="{Binding TodayHours, StringFormat='HEUTE {0}'}" Style="{StaticResource Caption}" FontSize="10" VerticalOptions="Center" />
            <Label Grid.Column="7" Text="{Binding Clock}" Style="{StaticResource Caption}" FontSize="10" VerticalOptions="Center" />
        </Grid>

        <!-- ========== Toasts ========== -->
        <VerticalStackLayout x:Name="ToastHost" Grid.Column="2" Spacing="8" Margin="0,0,20,20" WidthRequest="380"
                             HorizontalOptions="End" VerticalOptions="End" />
    </Grid>
</ContentPage>
