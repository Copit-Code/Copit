<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Copit.Controls"
             xmlns:v="clr-namespace:Copit.Views"
             x:Class="Copit.Views.ProjectsView"
             x:Name="Root">
    <Grid>
        <ScrollView Padding="32,24">
            <VerticalStackLayout Spacing="18">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="PROJEKTE" Style="{StaticResource Caption}" />
                        <Label Text="Epics &amp; Codebasen" Style="{StaticResource H1}" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Button Text="Neuer Ordner" Command="{Binding NewFolderCommand}" CommandParameter="{x:Null}" />
                        <Button Text="Neues Projekt" Style="{StaticResource Primary}" Command="{Binding NewCommand}" />
                    </HorizontalStackLayout>
                </Grid>

                <VerticalStackLayout IsVisible="{Binding IsEmpty}" Spacing="12" Margin="0,40,0,0" WidthRequest="520" HorizontalOptions="Start">
                    <c:AiOrb WidthRequest="40" HeightRequest="40" HorizontalOptions="Start" />
                    <Label Text="Noch keine Projekte" Style="{StaticResource H2}" />
                    <Label Text="Verbinde ein Jira-Epic mit deinem Quellordner. Copit zeigt dir Tickets, Pipeline und startet KI-Sessions direkt im Code."
                           Style="{StaticResource Sub}" LineBreakMode="WordWrap" />
                    <Button Text="Erstes Projekt anlegen" Style="{StaticResource Primary}" Command="{Binding NewCommand}" HorizontalOptions="Start" />
                </VerticalStackLayout>

                <!-- Tabelle -->
                <VerticalStackLayout Spacing="0" IsVisible="{Binding IsEmpty, Converter={StaticResource Not}}">
                    <Grid ColumnDefinitions="110,2*,1.4*,110,170,90,110" ColumnSpacing="16" Padding="10,0,10,8">
                        <Label Text="EPIC" Style="{StaticResource Caption}" />
                        <Label Grid.Column="1" Text="PROJEKT" Style="{StaticResource Caption}" />
                        <Label Grid.Column="2" Text="BRANCH" Style="{StaticResource Caption}" />
                        <Label Grid.Column="3" Text="PIPELINE" Style="{StaticResource Caption}" />
                        <Label Grid.Column="4" Text="FORTSCHRITT" Style="{StaticResource Caption}" />
                        <Label Grid.Column="5" Text="SESSIONS" Style="{StaticResource Caption}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource LineSoft}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="0">
                                    <!-- Ordner-Kopf: Klick klappt auf/zu, Projekte lassen sich hierher ziehen -->
                                    <Grid IsVisible="{Binding IsFolder}" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" Padding="{Binding Indent}" BackgroundColor="{StaticResource Bg2}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleFolderCommand}" CommandParameter="{Binding .}" />
                                            <DropGestureRecognizer AllowDrop="True" DragOver="OnFolderDragOver" DragLeave="OnFolderDragLeave" Drop="OnFolderDrop" />
                                        </Grid.GestureRecognizers>
                                        <c:Icon Name="{Binding Chevron}" Size="13" Color="{StaticResource Muted}" VerticalOptions="Center" />
                                        <c:Icon Grid.Column="1" Name="folder" Size="14" Color="{StaticResource Accent}" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding FolderName}" FontSize="13.5" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="3" Text="{Binding Count, StringFormat='{0} Projekte'}" Style="{StaticResource MonoLabel}" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                                        <c:IconButton Grid.Column="4" Icon="more" IconSize="13" WidthRequest="26" HeightRequest="26" ToolTipProperties.Text="Ordner-Aktionen"
                                                      Command="{Binding Source={x:Reference Root}, Path=BindingContext.FolderMenuCommand}" CommandParameter="{Binding .}" />
                                    </Grid>
                                    <!-- Projekt -->
                                    <Grid IsVisible="{Binding IsProject}" ColumnDefinitions="110,2*,1.4*,110,170,90,150" ColumnSpacing="16" Padding="{Binding Indent}" BackgroundColor="Transparent">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenCommand}" CommandParameter="{Binding .}" />
                                            <DragGestureRecognizer CanDrag="True" DragStarting="OnProjectDragStarting" />
                                        </Grid.GestureRecognizers>
                                        <Label Text="{Binding Card.Project.EpicKey}" Style="{StaticResource Key}" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Card.Project.Name}" FontSize="13.5" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Card.EpicSummary}" FontSize="11.5" TextColor="{StaticResource Muted}" LineBreakMode="TailTruncation" IsVisible="{Binding Card.EpicSummary, Converter={StaticResource HasText}}" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                            <c:Icon Name="branch" Size="13" Color="{StaticResource Muted}" />
                                            <Label Text="{Binding Card.Branch}" Style="{StaticResource MonoLabel}" LineBreakMode="MiddleTruncation" MaximumWidthRequest="220" VerticalOptions="Center" />
                                            <Label Text="{Binding Card.Changes, StringFormat='±{0}'}" Style="{StaticResource MonoLabel}" TextColor="{StaticResource Amber}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="Center" IsVisible="{Binding Card.HasPipeline}">
                                            <c:Icon Name="{Binding Card.PipelineStatus, Converter={StaticResource StatusIcon}}" Size="13" Color="{Binding Card.PipelineStatus, Converter={StaticResource StatusColor}}" />
                                            <Label Text="{Binding Card.PipelineStatus}" Style="{StaticResource Caption}" TextColor="{Binding Card.PipelineStatus, Converter={StaticResource StatusColor}}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <VerticalStackLayout Grid.Column="4" Spacing="5" VerticalOptions="Center">
                                            <ProgressBar Progress="{Binding Card.Progress}" />
                                            <Label Text="{Binding Card.ProgressText}" Style="{StaticResource MonoLabel}" FontSize="10.5" TextColor="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="5" Text="{Binding Card.Sessions}" Style="{StaticResource MonoLabel}" VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="6" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
                                            <c:IconButton Icon="folder" IconSize="13" WidthRequest="26" HeightRequest="26" ToolTipProperties.Text="In Ordner verschieben"
                                                          Command="{Binding Source={x:Reference Root}, Path=BindingContext.MoveProjectCommand}" CommandParameter="{Binding .}" />
                                            <Button Text="Session" Style="{StaticResource Chip}"
                                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenSessionCommand}" CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="{StaticResource LineSoft}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <!-- Ablagefläche: Projekt aus einem Ordner herausziehen -->
                    <Border x:Name="RootDrop" Padding="10,8" Margin="0,8,0,0" StrokeThickness="1" Stroke="{StaticResource LineSoft}" StrokeDashArray="3,3">
                        <Border.GestureRecognizers>
                            <DropGestureRecognizer AllowDrop="True" DragOver="OnFolderDragOver" DragLeave="OnFolderDragLeave" Drop="OnFolderDrop" />
                        </Border.GestureRecognizers>
                        <Label Text="Projekt hierher ziehen = ohne Ordner · auf einen Ordner ziehen = verschieben" Style="{StaticResource Caption}" TextColor="{StaticResource Muted}" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <v:ProjectEditorOverlay BindingContext="{Binding Editor}" />
    </Grid>
</ContentView>
