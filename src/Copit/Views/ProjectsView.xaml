<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Copit.Controls"
             xmlns:v="clr-namespace:Copit.Views"
             x:Class="Copit.Views.ProjectsView"
             x:Name="Root">
    <Grid>
        <ScrollView Padding="32,24">
            <VerticalStackLayout Spacing="18">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="PROJEKTE" Style="{StaticResource Caption}" />
                        <Label Text="Epics &amp; Codebasen" Style="{StaticResource H1}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Neues Projekt" Style="{StaticResource Primary}" Command="{Binding NewCommand}" VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout IsVisible="{Binding IsEmpty}" Spacing="12" Margin="0,40,0,0" WidthRequest="520" HorizontalOptions="Start">
                    <c:AiOrb WidthRequest="40" HeightRequest="40" HorizontalOptions="Start" />
                    <Label Text="Noch keine Projekte" Style="{StaticResource H2}" />
                    <Label Text="Verbinde ein Jira-Epic mit deinem Quellordner. Copit zeigt dir Tickets, Pipeline und startet KI-Sessions direkt im Code."
                           Style="{StaticResource Sub}" LineBreakMode="WordWrap" />
                    <Button Text="Erstes Projekt anlegen" Style="{StaticResource Primary}" Command="{Binding NewCommand}" HorizontalOptions="Start" />
                </VerticalStackLayout>

                <!-- Tabelle -->
                <VerticalStackLayout Spacing="0" IsVisible="{Binding IsEmpty, Converter={StaticResource Not}}">
                    <Grid ColumnDefinitions="110,2*,1.4*,110,170,90,110" ColumnSpacing="16" Padding="10,0,10,8">
                        <Label Text="EPIC" Style="{StaticResource Caption}" />
                        <Label Grid.Column="1" Text="PROJEKT" Style="{StaticResource Caption}" />
                        <Label Grid.Column="2" Text="BRANCH" Style="{StaticResource Caption}" />
                        <Label Grid.Column="3" Text="PIPELINE" Style="{StaticResource Caption}" />
                        <Label Grid.Column="4" Text="FORTSCHRITT" Style="{StaticResource Caption}" />
                        <Label Grid.Column="5" Text="SESSIONS" Style="{StaticResource Caption}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource LineSoft}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Projects}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="0">
                                    <Grid ColumnDefinitions="110,2*,1.4*,110,170,90,110" ColumnSpacing="16" Padding="10,12" BackgroundColor="Transparent">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenCommand}" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Label Text="{Binding Project.EpicKey}" Style="{StaticResource Key}" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Project.Name}" FontSize="13.5" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding EpicSummary}" FontSize="11.5" TextColor="{StaticResource Muted}" LineBreakMode="TailTruncation" IsVisible="{Binding EpicSummary, Converter={StaticResource HasText}}" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                            <c:Icon Name="branch" Size="13" Color="{StaticResource Muted}" />
                                            <Label Text="{Binding Branch}" Style="{StaticResource MonoLabel}" LineBreakMode="MiddleTruncation" MaximumWidthRequest="220" VerticalOptions="Center" />
                                            <Label Text="{Binding Changes, StringFormat='±{0}'}" Style="{StaticResource MonoLabel}" TextColor="{StaticResource Amber}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="Center" IsVisible="{Binding HasPipeline}">
                                            <c:Icon Name="{Binding PipelineStatus, Converter={StaticResource StatusIcon}}" Size="13" Color="{Binding PipelineStatus, Converter={StaticResource StatusColor}}" />
                                            <Label Text="{Binding PipelineStatus}" Style="{StaticResource Caption}" TextColor="{Binding PipelineStatus, Converter={StaticResource StatusColor}}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <VerticalStackLayout Grid.Column="4" Spacing="5" VerticalOptions="Center">
                                            <ProgressBar Progress="{Binding Progress}" />
                                            <Label Text="{Binding ProgressText}" Style="{StaticResource MonoLabel}" FontSize="10.5" TextColor="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="5" Text="{Binding Sessions}" Style="{StaticResource MonoLabel}" VerticalOptions="Center" />
                                        <Button Grid.Column="6" Text="Session" Style="{StaticResource Chip}" HorizontalOptions="End" VerticalOptions="Center"
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenSessionCommand}" CommandParameter="{Binding .}" />
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="{StaticResource LineSoft}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <v:ProjectEditorOverlay BindingContext="{Binding Editor}" />
    </Grid>
</ContentView>
