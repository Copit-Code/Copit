<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Copit.Converters"
             x:Class="Copit.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ============ Palette: warmes Dunkel, ein Akzent ============ -->
            <Color x:Key="Bg">#14110F</Color>
            <Color x:Key="Bg2">#181412</Color>
            <Color x:Key="Panel">#1B1714</Color>
            <Color x:Key="Card">#1E1916</Color>
            <Color x:Key="CardHover">#28211C</Color>
            <Color x:Key="Line">#3A322B</Color>
            <Color x:Key="LineSoft">#2A241F</Color>
            <Color x:Key="Text">#ECE5DC</Color>
            <Color x:Key="Text2">#B3A89C</Color>
            <Color x:Key="Muted">#7A6F65</Color>
            <Color x:Key="Accent">#E8743B</Color>
            <Color x:Key="AccentSoft">#33211A</Color>
            <Color x:Key="Cyan">#E8743B</Color>
            <Color x:Key="CyanSoft">#33211A</Color>
            <Color x:Key="Green">#7BC47F</Color>
            <Color x:Key="GreenSoft">#1D271D</Color>
            <Color x:Key="Amber">#D9A441</Color>
            <Color x:Key="AmberSoft">#2F2617</Color>
            <Color x:Key="Red">#E0604F</Color>
            <Color x:Key="RedSoft">#351C18</Color>
            <Color x:Key="Pink">#D88A6A</Color>

            <SolidColorBrush x:Key="AccentGradient" Color="#E8743B" />
            <SolidColorBrush x:Key="HeroGradient" Color="#181412" />

            <x:String x:Key="Icons">Segoe Fluent Icons</x:String>
            <x:String x:Key="Mono">Cascadia Mono</x:String>

            <!-- ============ Converters ============ -->
            <conv:InverseBoolConverter x:Key="Not" />
            <conv:HasTextConverter x:Key="HasText" />
            <conv:NoTextConverter x:Key="NoText" />
            <conv:NotNullConverter x:Key="NotNull" />
            <conv:IsNullConverter x:Key="IsNull" />
            <conv:StatusColorConverter x:Key="StatusColor" />
            <conv:StatusSoftColorConverter x:Key="StatusSoft" />
            <conv:StatusIconConverter x:Key="StatusIcon" />
            <conv:HexColorConverter x:Key="Hex" />
            <conv:CountToBoolConverter x:Key="Any" />
            <conv:CountToBoolConverter x:Key="None" Invert="True" />
            <conv:SeverityColorConverter x:Key="SeverityColor" />
            <conv:EqualsConverter x:Key="Equals" />

            <!-- ============ Basis ============ -->
            <Style TargetType="Page" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource Bg}" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Text}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource Text}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
                <Setter Property="BackgroundColor" Value="{StaticResource Bg2}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinimumHeightRequest" Value="32" />
            </Style>
            <Style TargetType="Editor">
                <Setter Property="TextColor" Value="{StaticResource Text}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
                <Setter Property="BackgroundColor" Value="{StaticResource Bg2}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource Text}" />
                <Setter Property="TitleColor" Value="{StaticResource Muted}" />
                <Setter Property="BackgroundColor" Value="{StaticResource Bg2}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="TextColor" Value="{StaticResource Text}" />
                <Setter Property="BackgroundColor" Value="{StaticResource Bg2}" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Color" Value="{StaticResource Accent}" />
            </Style>
            <Style TargetType="Switch">
                <Setter Property="OnColor" Value="{StaticResource Accent}" />
                <Setter Property="ThumbColor" Value="{StaticResource Text}" />
            </Style>
            <Style TargetType="ProgressBar">
                <Setter Property="ProgressColor" Value="{StaticResource Accent}" />
                <Setter Property="BackgroundColor" Value="{StaticResource LineSoft}" />
                <Setter Property="HeightRequest" Value="3" />
            </Style>
            <Style TargetType="ActivityIndicator">
                <Setter Property="Color" Value="{StaticResource Accent}" />
            </Style>
            <Style TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="Rectangle" />
            </Style>

            <!-- ============ Buttons: eckig, 1px ============ -->
            <Style x:Key="Btn" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Text}" />
                <Setter Property="BorderColor" Value="{StaticResource Line}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="MinimumHeightRequest" Value="30" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource CardHover}" />
                                    <Setter Property="BorderColor" Value="{StaticResource Muted}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.4" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource Btn}" />

            <Style x:Key="Primary" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Text}" />
                <Setter Property="TextColor" Value="{StaticResource Bg}" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="MinimumHeightRequest" Value="30" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.35" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="TextColor" Value="{StaticResource Text2}" />
            </Style>

            <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="BorderColor" Value="#5A2C25" />
                <Setter Property="TextColor" Value="{StaticResource Red}" />
            </Style>

            <Style x:Key="Icon" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="FontFamily" Value="{StaticResource Icons}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="30" />
                <Setter Property="HeightRequest" Value="30" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="TextColor" Value="{StaticResource Text2}" />
            </Style>

            <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="FontFamily" Value="{StaticResource Mono}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="0.8" />
                <Setter Property="TextTransform" Value="Uppercase" />
                <Setter Property="Padding" Value="9,3" />
                <Setter Property="MinimumHeightRequest" Value="24" />
                <Setter Property="TextColor" Value="{StaticResource Text2}" />
            </Style>

            <!-- ============ Flächen ============ -->
            <Style x:Key="CardBox" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Panel}" />
                <Setter Property="Stroke" Value="{StaticResource LineSoft}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="Rectangle" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="PanelBox" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Bg2}" />
                <Setter Property="Stroke" Value="{StaticResource LineSoft}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="Rectangle" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="StrokeShape" Value="Rectangle" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- ============ Typo ============ -->
            <Style x:Key="H1" TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Text}" />
            </Style>
            <Style x:Key="H2" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Text}" />
            </Style>
            <Style x:Key="H3" TargetType="Label">
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Text}" />
            </Style>
            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource Mono}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="TextColor" Value="{StaticResource Muted}" />
                <Setter Property="CharacterSpacing" Value="1.6" />
                <Setter Property="TextTransform" Value="Uppercase" />
            </Style>
            <Style x:Key="Sub" TargetType="Label">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="TextColor" Value="{StaticResource Text2}" />
            </Style>
            <Style x:Key="MonoLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource Mono}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="TextColor" Value="{StaticResource Text2}" />
            </Style>
            <Style x:Key="Key" TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource Mono}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="TextColor" Value="{StaticResource Accent}" />
            </Style>
            <Style x:Key="Glyph" TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource Icons}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource Text2}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
