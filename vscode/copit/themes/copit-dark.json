  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6A5F55", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#E8743B" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#A9C47F" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#D9A441" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#E8C58B" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"], "settings": { "foreground": "#7FC2B8" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#ECE5DC" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#D8CFC4" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#E8743B" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#D9A441" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#9A8F84" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#E8743B", "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#7BC47F" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#E0604F" } }
  ]
}
